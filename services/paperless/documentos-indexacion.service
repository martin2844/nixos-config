[Unit]
Description=Indexación local de los documentos de Ediloco
PartOf=paperless.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/martin/Projects/documentos-ediloco
ExecStart=/run/current-system/sw/bin/flock -n /home/martin/Projects/documentos-ediloco/state/controller.lock /home/martin/.nix-profile/bin/ediloco-node /home/martin/Projects/documentos-ediloco/indexar-todo.mjs
Restart=on-failure
RestartSec=120
TimeoutStopSec=180
UMask=0077
StandardOutput=journal
StandardError=journal

# Bulk indexing is resumed explicitly with indexar.sh, never at login.
