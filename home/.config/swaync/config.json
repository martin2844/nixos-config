{
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "control-center-width": 460,
  "notification-window-width": 460,
  "timeout": 8,
  "timeout-critical": 0,
  "widgets": [
    "title",
    "dnd",
    "notifications"
  ],
  "scripts": {},
  "cssPriority": "user",
  "image-visibility": "always",
  "control-center-margin-top": 12,
  "control-center-margin-right": 12,
  "control-center-margin-bottom": 12,
  "widget-config": {
    "title": {
      "text": "Notifications",
      "button-text": "Clear all"
    },
    "dnd": {
      "text": "Do not disturb"
    }
  }
}
