{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 2,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray#apps",
    "custom/windows",
    "custom/separator",
    "tray#network",
    "bluetooth",
    "pulseaudio",
    "custom/tailscale",
    "custom/codex",
    "cpu",
    "memory",
    "custom/notifications",
    "custom/settings"
  ],
  "hyprland/workspaces": {
    "format": "{id}",
    "all-outputs": true,
    "disable-scroll": true,
    "persistent-workspaces": {
      "*": 9
    }
  },
  "hyprland/window": {
    "max-length": 45,
    "separate-outputs": true
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "custom/settings": {
    "format": "",
    "tooltip-format": "System settings (Super+,)",
    "on-click": "uwsm app -- hyprmod"
  },
  "custom/codex": {
    "exec": "/home/martin/.nix-profile/bin/codex-usage",
    "return-type": "json",
    "interval": 120,
    "format": "{text}",
    "on-click": "uwsm app -- chatgpt"
  },
  "bluetooth": {
    "format": "",
    "format-connected": "󰂱",
    "on-click": "uwsm app -- /home/martin/.nix-profile/bin/desktop-controls bluetooth",
    "format-on": "",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-no-controller": "󰂲",
    "tooltip-format": "Bluetooth: {status}\nClic: gestionar dispositivos",
    "tooltip-format-connected": "Bluetooth: {num_connections} conectado(s)\n{device_enumerate}"
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "on-click": "uwsm app -- /home/martin/.nix-profile/bin/desktop-controls audio",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5,
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ],
      "headphone": "󰋋"
    },
    "tooltip-format": "Volumen: {volume}%\n{desc}\nClic: controles · Clic derecho: silenciar"
  },
  "cpu": {
    "format": " {usage}%",
    "interval": 5,
    "tooltip-format": "CPU: {usage}%"
  },
  "memory": {
    "format": " {percentage}%",
    "interval": 5,
    "tooltip-format": "RAM: {used:0.1f} / {total:0.1f} GiB ({percentage}%)"
  },
  "custom/notifications": {
    "format": "󰂚",
    "on-click": "swaync-client -t",
    "tooltip": true,
    "tooltip-format": "Notificaciones"
  },
  "network": {
    "format-ethernet": "󰈀",
    "format-wifi": "󰤨",
    "format-disconnected": "󰤭",
    "format-linked": "󰤫",
    "tooltip-format": "{ifname}: {ipaddr}\nClick for Ethernet and Wi-Fi",
    "tooltip-format-disconnected": "Sin conexión\nClic: Ethernet y Wi-Fi",
    "on-click": "uwsm app -- /home/martin/.nix-profile/bin/nmgui",
    "on-click-right": "uwsm app -- nm-connection-editor",
    "interval": 5,
    "tooltip-format-ethernet": "Ethernet · {ifname}\n{ipaddr}\nClic: Ethernet y Wi-Fi",
    "tooltip-format-wifi": "Wi-Fi · {essid}\nSeñal: {signalStrength}% · {ipaddr}\nClic: Ethernet y Wi-Fi"
  },
  "tray#apps": {
    "icon-size": 18,
    "spacing": 10,
    "ignored-items": [
      "/org/ayatana/NotificationItem/nm_applet",
      "/org/blueman/sni"
    ],
    "icons": {
      "nm-applet": "/home/martin/.config/waybar/icons/network.svg"
    },
    "show-passive-items": true
  },
  "tray#network": {
    "icon-size": 18,
    "spacing": 10,
    "ignored-items": [],
    "icons": {
      "nm-applet": "/home/martin/.config/waybar/icons/network.svg"
    },
    "allowed-items": [
      "/org/ayatana/NotificationItem/nm_applet"
    ]
  },
  "custom/separator": {
    "format": "│",
    "tooltip": false
  },
  "custom/tailscale": {
    "exec": "/home/martin/.nix-profile/bin/desktop-controls tailscale-status",
    "return-type": "json",
    "interval": 10,
    "format": "{text}",
    "on-click": "uwsm app -- trayscale"
  },
  "custom/windows": {
    "format": "󰍜",
    "tooltip-format": "Ventanas abiertas · desplegar lista",
    "on-click": "uwsm app -- /home/martin/.nix-profile/bin/desktop-controls windows"
  }
}
