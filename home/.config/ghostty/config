theme = dark:Adwaita Dark,light:Adwaita Dark
font-family = JetBrainsMono Nerd Font
font-size = 11
# Use an opaque background so new windows remain readable over the desktop.
background-opacity = 1.0
window-padding-x = 8
window-padding-y = 8
command = zsh -l
copy-on-select = clipboard
# Keep new launches independent of long-running terminal processes.
gtk-single-instance = false
