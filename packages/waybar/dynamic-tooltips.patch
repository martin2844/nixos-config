 auto ALabel::update() -> void { AModule::update(); }
+
+bool ALabel::pointerOverModule() const {
+  auto window = event_box_.get_window();
+  if (!window || !event_box_.get_mapped()) {
+    return false;
+  }
+  int x = 0;
+  int y = 0;
+  Gdk::ModifierType mask;
+  window->get_device_position(window->get_display()->get_default_seat()->get_pointer(), x, y, mask);
+  return x >= 0 && y >= 0 && x < window->get_width() && y < window->get_height();
+}
+
+bool ALabel::setTooltipMarkup(const Glib::ustring& markup) {
+  if (last_tooltip_markup_ == markup.raw()) {
+    return false;
+  }
+  last_tooltip_markup_ = markup.raw();
+  if (active_tooltip_) {
+    // GTK can reuse one tooltip object across adjacent modules without a leave event.
+    if (pointerOverModule()) {
+      active_tooltip_->set_markup(markup);
+    } else {
+      active_tooltip_.reset();
+    }
+  }
+  return true;
+}
+
+void ALabel::setTooltipText(const Glib::ustring& text) {
+  setTooltipMarkup(Glib::Markup::escape_text(text));
+}
 
